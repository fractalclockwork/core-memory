	(text "MAGNETIC CORES — 64×64 MCE\nCheckerboard is the 2×2 rule scaled, not a traced plane weave.\n(x+y) even: YA loop, mirrored, diagonals x-y, S1 toward the top-left.\n(x+y) odd: YB loop, unmirrored, diagonals x+y, S1 toward the top-right.\nXA→XB top→bottom; YA→YB right→left. Fold YA66=YB65."
		(exclude_from_sim no)
		(at 20 18 0)
		(effects (font (size 2.0 2.0)) (justify left))
		(uuid "4767fc50-8aa0-4922-997a-8086defa1eba")
	)
