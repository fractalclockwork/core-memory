* 2x2 matrix with the inhibit sheet (inhibit.cir) on CCS_INH.
* Same weave and Sim.Pins map as array2x2_tb.cir.
*
* One CCS for the X lines, one for the Y lines, one for inhibit, each 400 mA.
* Only one line on an axis is driven at a time, so that axis sink is the
* full half-select. All four cores start at m=-1.
*
* X00  X0/Y0  2 write 1, 8 read 1, 14 write-back 1, 20 clear, 26 write 0, 32 read 0, 38 write-back 0
* X01  X1/Y0  44 write 1, 50 read 1, 56 write-back 1, 62 clear, 68 write 0, 74 read 0, 80 write-back 0
* X10  X0/Y1  86 write 1, 92 read 1, 98 write-back 1, 104 clear, 110 write 0, 116 read 0, 122 write-back 0
* X11  X1/Y1  128 write 1, 134 read 1, 140 write-back 1, 146 clear, 152 write 0, 158 read 0, 164 write-back 0
*
* 1 us edges, 2 us flat, 1 us fall. Read sinks the A end (B->A).
* Write sinks the B end. Inhibit sources YA65 and sinks YB66.
* VDRIVE = 12 V is testbench headroom, not a frozen rail.
*
* Positive probe current is A->B. Batch: ngspice -b array2x2_matrix_tb.cir
* Prints RESULT PASS or RESULT FAIL.

.include coremem.cir
.include ccs.cir
.include drive.cir
.include inhibit.cir

.param vdrive=12

Vdrive vdrv 0 DC {vdrive}
Viccsx ccs_x ccs_xin 0
Viccsy ccs_y ccs_yin 0
Viccsi ccs_i ccs_iin 0
Xccs_x ccs_xin ccs ic_half=0.4
Xccs_y ccs_yin ccs ic_half=0.4
Xccs_i ccs_iin ccs ic_half=0.4
Rx ccs_x 0 10Meg
Ry ccs_y 0 10Meg
Ri ccs_i 0 10Meg

Rxa0 xa0d 0 10Meg
Rxa1 xa1d 0 10Meg
Rya0 ya0d 0 10Meg
Rya1 ya1d 0 10Meg
Rfold FOLD 0 10k

* X1 X2 Y1 Y2 S1 S2
X00 XA0 nX0 nY0 YB0 FOLD nSA mce m0=-1
X10 nX0 XB0 nY1 YB1 nSB FOLD mce m0=-1
X01 XA1 nX1 YA0 nY0 YB66 nSB mce m0=-1
X11 nX1 XB1 YA1 nY1 nSA YA65 mce m0=-1

Bdiff DIFF 0 V = V(YA65)-V(YB66)

Vixa0 xa0d XA0 0
Vixa1 xa1d XA1 0
Viya0 ya0d YA0 0
Viya1 ya1d YA1 0
Vinh inhd YA65 0
Bpxa0 PXA0 0 V = I(Vixa0)
Bpxa1 PXA1 0 V = I(Vixa1)
Bpya0 PYA0 0 V = I(Viya0)
Bpya1 PYA1 0 V = I(Viya1)
Bpinh PINH 0 V = I(Vinh)
Bpiccsx PICCSX 0 V = I(Viccsx)
Bpiccsy PICCSY 0 V = I(Viccsy)
Bpiccsi PICCSI 0 V = I(Viccsi)

* Ramps from a few hundred ohms down to 1 ohm across the 1 us edge.
.subckt drvsw a b ctl
Bsw a b I=(v(ctl)>0.02 ? v(a,b)/(1+400*(1-min(v(ctl),1))) : 0)
.ends

* 200 ns on each gate. A raw PWL corner into both lines of a shared HS
* drops the trap step to the floor.
.subckt glag in out
R1 in out 2k
C1 out 0 100p
.ends
Xlx0r g_x0r gx0r glag
Xlx1r g_x1r gx1r glag
Xlx0w g_x0w gx0w glag
Xlx1w g_x1w gx1w glag
Xly0r g_y0r gy0r glag
Xly1r g_y1r gy1r glag
Xly0w g_y0w gy0w glag
Xly1w g_y1w gy1w glag

* Matrix: group-0 HS feeds both lines; LS group selects the line.
* FWD/READ sources B and sinks A. REV/WRITE sources A and sinks B.
* Group-1 HS has no plane diode. Inhibit stays the ideal switch.
Bhsxr hsxr 0 V=max(v(gx0r),v(gx1r))
Bhsxw hsxw 0 V=max(v(gx0w),v(gx1w))
Bhsyr hsyr 0 V=max(v(gy0r),v(gy1r))
Bhsyw hsyw 0 V=max(v(gy0w),v(gy1w))
Vg_off g_off 0 DC 0
Vpxhs1 vdrv pxhs1 0
Vpxhs1w vdrv pxhs1w 0
Vpyhs1 vdrv pyhs1 0
Vpyhs1w vdrv pyhs1w 0
Xxf_hs0 vdrv XB0 hsxr drvleg
Xxf_hs0b vdrv XB1 hsxr drvleg
Xxf_ls0 xa0d ccs_x gx0r drvleg
Xxf_ls1 xa1d ccs_x gx1r drvleg
Xxf_hs1 pxhs1 xhs1n g_off drvleg
Rxhs1 xhs1n 0 10Meg
Xxw_hs0 vdrv xa0d hsxw drvleg
Xxw_hs0b vdrv xa1d hsxw drvleg
Xxw_ls0 XB0 ccs_x gx0w drvleg
Xxw_ls1 XB1 ccs_x gx1w drvleg
Xxw_hs1 pxhs1w xhs1nw g_off drvleg
Rxhs1w xhs1nw 0 10Meg
Xyf_hs0 vdrv YB0 hsyr drvleg
Xyf_hs0b vdrv YB1 hsyr drvleg
Xyf_ls0 ya0d ccs_y gy0r drvleg
Xyf_ls1 ya1d ccs_y gy1r drvleg
Xyf_hs1 pyhs1 yhs1n g_off drvleg
Ryhs1 yhs1n 0 10Meg
Xyw_hs0 vdrv ya0d hsyw drvleg
Xyw_hs0b vdrv ya1d hsyw drvleg
Xyw_ls0 YB0 ccs_y gy0w drvleg
Xyw_ls1 YB1 ccs_y gy1w drvleg
Xyw_hs1 pyhs1w yhs1nw g_off drvleg
Ryhs1w yhs1nw 0 10Meg
Xinh vdrv inhd YB66 ccs_i g_inh inhibit

Vg_x0w g_x0w 0 PWL(
+ 0 0
+ 2u 0 3u 1 5u 1 6u 0
+ 14u 0 15u 1 17u 1 18u 0
+ 26u 0 27u 1 29u 1 30u 0
+ 38u 0 39u 1 41u 1 42u 0
+ 86u 0 87u 1 89u 1 90u 0
+ 98u 0 99u 1 101u 1 102u 0
+ 110u 0 111u 1 113u 1 114u 0
+ 122u 0 123u 1 125u 1 126u 0)
Vg_x0r g_x0r 0 PWL(
+ 0 0
+ 8u 0 9u 1 11u 1 12u 0
+ 20u 0 21u 1 23u 1 24u 0
+ 32u 0 33u 1 35u 1 36u 0
+ 92u 0 93u 1 95u 1 96u 0
+ 104u 0 105u 1 107u 1 108u 0
+ 116u 0 117u 1 119u 1 120u 0)
Vg_x1w g_x1w 0 PWL(
+ 0 0
+ 44u 0 45u 1 47u 1 48u 0
+ 56u 0 57u 1 59u 1 60u 0
+ 68u 0 69u 1 71u 1 72u 0
+ 80u 0 81u 1 83u 1 84u 0
+ 128u 0 129u 1 131u 1 132u 0
+ 140u 0 141u 1 143u 1 144u 0
+ 152u 0 153u 1 155u 1 156u 0
+ 164u 0 165u 1 167u 1 168u 0)
Vg_x1r g_x1r 0 PWL(
+ 0 0
+ 50u 0 51u 1 53u 1 54u 0
+ 62u 0 63u 1 65u 1 66u 0
+ 74u 0 75u 1 77u 1 78u 0
+ 134u 0 135u 1 137u 1 138u 0
+ 146u 0 147u 1 149u 1 150u 0
+ 158u 0 159u 1 161u 1 162u 0)
Vg_y0w g_y0w 0 PWL(
+ 0 0
+ 2u 0 3u 1 5u 1 6u 0
+ 14u 0 15u 1 17u 1 18u 0
+ 26u 0 27u 1 29u 1 30u 0
+ 38u 0 39u 1 41u 1 42u 0
+ 44u 0 45u 1 47u 1 48u 0
+ 56u 0 57u 1 59u 1 60u 0
+ 68u 0 69u 1 71u 1 72u 0
+ 80u 0 81u 1 83u 1 84u 0)
Vg_y0r g_y0r 0 PWL(
+ 0 0
+ 8u 0 9u 1 11u 1 12u 0
+ 20u 0 21u 1 23u 1 24u 0
+ 32u 0 33u 1 35u 1 36u 0
+ 50u 0 51u 1 53u 1 54u 0
+ 62u 0 63u 1 65u 1 66u 0
+ 74u 0 75u 1 77u 1 78u 0)
Vg_y1w g_y1w 0 PWL(
+ 0 0
+ 86u 0 87u 1 89u 1 90u 0
+ 98u 0 99u 1 101u 1 102u 0
+ 110u 0 111u 1 113u 1 114u 0
+ 122u 0 123u 1 125u 1 126u 0
+ 128u 0 129u 1 131u 1 132u 0
+ 140u 0 141u 1 143u 1 144u 0
+ 152u 0 153u 1 155u 1 156u 0
+ 164u 0 165u 1 167u 1 168u 0)
Vg_y1r g_y1r 0 PWL(
+ 0 0
+ 92u 0 93u 1 95u 1 96u 0
+ 104u 0 105u 1 107u 1 108u 0
+ 116u 0 117u 1 119u 1 120u 0
+ 134u 0 135u 1 137u 1 138u 0
+ 146u 0 147u 1 149u 1 150u 0
+ 158u 0 159u 1 161u 1 162u 0)
* Fall is 0.5 us longer than the drive PWL so inhibit is still up while
* the lagged gates finish turning off.
Vg_inh g_inh 0 PWL(
+ 0 0
+ 26u 0 27u 1 29u 1 30.5u 0
+ 38u 0 39u 1 41u 1 42.5u 0
+ 68u 0 69u 1 71u 1 72.5u 0
+ 80u 0 81u 1 83u 1 84.5u 0
+ 110u 0 111u 1 113u 1 114.5u 0
+ 122u 0 123u 1 125u 1 126.5u 0
+ 152u 0 153u 1 155u 1 156.5u 0
+ 164u 0 165u 1 167u 1 168.5u 0)

* Trap steps through the inhibited write. Gear collapses the timestep
* while every core sits on the remanence rail.
.options reltol=1e-3 method=trap cshunt=1p
.tran 20n 170u uic

.control
set nobreak
set noaskquit
run
meas tran i_unsel_x AVG i(Vixa1) FROM=10.2u TO=10.8u
meas tran i_unsel_y AVG i(Viya1) FROM=10.2u TO=10.8u
meas tran i_unsel_x0 AVG i(Vixa0) FROM=52.2u TO=52.8u
meas tran i_g1 AVG i(Vpxhs1) FROM=10.2u TO=10.8u

* State 0.5 us after each pulse. Sense plateau is after the rise.
meas tran m_x00_x00_w1 FIND v(x00.xcore.m) AT=7.3u
meas tran m_x01_x00_w1 FIND v(x01.xcore.m) AT=7.3u
meas tran m_x10_x00_w1 FIND v(x10.xcore.m) AT=7.3u
meas tran m_x11_x00_w1 FIND v(x11.xcore.m) AT=7.3u
meas tran smax_x00_w1 MAX v(diff) FROM=3.15u TO=5u
meas tran smin_x00_w1 MIN v(diff) FROM=3.15u TO=5u
meas tran ix_x00_w1 AVG i(Vixa0) FROM=4.2u TO=4.8u
meas tran iy_x00_w1 AVG i(Viya0) FROM=4.2u TO=4.8u
meas tran m_x00_x00_r1 FIND v(x00.xcore.m) AT=13.3u
