  echo FAIL X11 read 0 Y current strong
end
if m_x00_x11_b0 > -0.9
  let fail = 1
  echo FAIL X11 write-back 0 left X00 high
end
if m_x01_x11_b0 > -0.9
  let fail = 1
  echo FAIL X11 write-back 0 left X01 high
end
if m_x10_x11_b0 > -0.9
  let fail = 1
  echo FAIL X11 write-back 0 left X10 high
end
if m_x11_x11_b0 > -0.9
  let fail = 1
  echo FAIL X11 write-back 0 left X11 high
end
let pk = smax_x11_b0
if abs(smin_x11_b0) > pk
  let pk = abs(smin_x11_b0)
end
if pk > 15m
  let fail = 1
  echo FAIL X11 write-back 0 produced a flip plateau
end
if ix_x11_b0 < 0.34
  let fail = 1
  echo FAIL X11 write-back 0 X current low
end
if ix_x11_b0 > 0.46
  let fail = 1
  echo FAIL X11 write-back 0 X current high
end
if iy_x11_b0 < 0.34
  let fail = 1
  echo FAIL X11 write-back 0 Y current low
end
if iy_x11_b0 > 0.46
  let fail = 1
  echo FAIL X11 write-back 0 Y current high
end
if ii_x11_b0 < 0.34
  let fail = 1
  echo FAIL X11 write-back 0 inhibit current low
end
if ii_x11_b0 > 0.46
  let fail = 1
  echo FAIL X11 write-back 0 inhibit current high
end


if abs(i_unsel_x) > 0.05
  let fail = 1
  echo FAIL unselected X1 current during X00 read
end
if abs(i_unsel_y) > 0.05
  let fail = 1
  echo FAIL unselected Y1 current during X00 read
end
if abs(i_unsel_x0) > 0.05
  let fail = 1
  echo FAIL unselected X0 current during X01 read
end
if abs(i_g1) > 0.005
  let fail = 1
  echo FAIL group-1 HS current while address stays in group 0
end
if fail = 0
  echo RESULT PASS
else
  echo RESULT FAIL
end
.endc
.end

