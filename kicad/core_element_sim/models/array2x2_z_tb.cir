  echo FAIL X11 write-back 1 sense above 80 mV
end
if ix_x11_b1 < 0.34
  let fail = 1
  echo FAIL X11 write-back 1 X current low
end
if ix_x11_b1 > 0.46
  let fail = 1
  echo FAIL X11 write-back 1 X current high
end
if iy_x11_b1 < 0.34
  let fail = 1
  echo FAIL X11 write-back 1 Y current low
end
if iy_x11_b1 > 0.46
  let fail = 1
  echo FAIL X11 write-back 1 Y current high
end
if m_x00_x11_clr > -0.9
  let fail = 1
  echo FAIL X11 clear left X00 high
end
if m_x01_x11_clr > -0.9
  let fail = 1
  echo FAIL X11 clear left X01 high
end
if m_x10_x11_clr > -0.9
  let fail = 1
  echo FAIL X11 clear left X10 high
end
if m_x11_x11_clr > -0.9
  let fail = 1
  echo FAIL X11 clear left X11 high
end
let pk = smax_x11_clr
if abs(smin_x11_clr) > pk
  let pk = abs(smin_x11_clr)
end
if pk < 15m
  let fail = 1
  echo FAIL X11 clear sense below 15 mV
end
if pk > 80m
  let fail = 1
  echo FAIL X11 clear sense above 80 mV
end
if ix_x11_clr > -0.34
  let fail = 1
  echo FAIL X11 clear X current weak
end
if ix_x11_clr < -0.46
  let fail = 1
  echo FAIL X11 clear X current strong
end
if iy_x11_clr > -0.34
  let fail = 1
  echo FAIL X11 clear Y current weak
end
if iy_x11_clr < -0.46
  let fail = 1
  echo FAIL X11 clear Y current strong
end
if m_x00_x11_w0 > -0.9
  let fail = 1
  echo FAIL X11 write 0 left X00 high
end
if m_x01_x11_w0 > -0.9
  let fail = 1
  echo FAIL X11 write 0 left X01 high
end
if m_x10_x11_w0 > -0.9
  let fail = 1
  echo FAIL X11 write 0 left X10 high
end
if m_x11_x11_w0 > -0.9
  let fail = 1
  echo FAIL X11 write 0 left X11 high
end
let pk = smax_x11_w0
if abs(smin_x11_w0) > pk
  let pk = abs(smin_x11_w0)
end
if pk > 15m
  let fail = 1
  echo FAIL X11 write 0 produced a flip plateau
end
if ix_x11_w0 < 0.34
  let fail = 1
  echo FAIL X11 write 0 X current low
end
if ix_x11_w0 > 0.46
  let fail = 1
  echo FAIL X11 write 0 X current high
end
if iy_x11_w0 < 0.34
  let fail = 1
  echo FAIL X11 write 0 Y current low
end
if iy_x11_w0 > 0.46
  let fail = 1
  echo FAIL X11 write 0 Y current high
end
if ii_x11_w0 < 0.34
  let fail = 1
  echo FAIL X11 write 0 inhibit current low
end
if ii_x11_w0 > 0.46
  let fail = 1
  echo FAIL X11 write 0 inhibit current high
end
if m_x00_x11_r0 > -0.9
  let fail = 1
  echo FAIL X11 read 0 left X00 high
end
if m_x01_x11_r0 > -0.9
  let fail = 1
  echo FAIL X11 read 0 left X01 high
end
if m_x10_x11_r0 > -0.9
  let fail = 1
  echo FAIL X11 read 0 left X10 high
end
if m_x11_x11_r0 > -0.9
  let fail = 1
  echo FAIL X11 read 0 left X11 high
end
let pk = smax_x11_r0
if abs(smin_x11_r0) > pk
  let pk = abs(smin_x11_r0)
end
if pk > 15m
  let fail = 1
  echo FAIL X11 read 0 produced a flip plateau
end
if ix_x11_r0 > -0.34
  let fail = 1
  echo FAIL X11 read 0 X current weak
end
if ix_x11_r0 < -0.46
  let fail = 1
  echo FAIL X11 read 0 X current strong
end
if iy_x11_r0 > -0.34
  let fail = 1
  echo FAIL X11 read 0 Y current weak
end
if iy_x11_r0 < -0.46
  let fail = 1
  echo FAIL X11 read 0 Y current strong
end
if m_x00_x11_b0 > -0.9
  let fail = 1
  echo FAIL X11 write-back 0 left X00 high
end
if m_x01_x11_b0 > -0.9
  let fail = 1
  echo FAIL X11 write-back 0 left X01 high
end
if m_x10_x11_b0 > -0.9
  let fail = 1
  echo FAIL X11 write-back 0 left X10 high
end
if m_x11_x11_b0 > -0.9
  let fail = 1
  echo FAIL X11 write-back 0 left X11 high
end
let pk = smax_x11_b0
if abs(smin_x11_b0) > pk
  let pk = abs(smin_x11_b0)
end
if pk > 15m
  let fail = 1
  echo FAIL X11 write-back 0 produced a flip plateau
end
if ix_x11_b0 < 0.34
  let fail = 1
  echo FAIL X11 write-back 0 X current low
end
if ix_x11_b0 > 0.46
  let fail = 1
  echo FAIL X11 write-back 0 X current high
end
if iy_x11_b0 < 0.34
  let fail = 1
  echo FAIL X11 write-back 0 Y current low
end
if iy_x11_b0 > 0.46
  let fail = 1
  echo FAIL X11 write-back 0 Y current high
end
if ii_x11_b0 < 0.34
  let fail = 1
  echo FAIL X11 write-back 0 inhibit current low
end
if ii_x11_b0 > 0.46
  let fail = 1
  echo FAIL X11 write-back 0 inhibit current high
end


if abs(i_unsel_x) > 0.05
  let fail = 1
  echo FAIL unselected X1 current during X00 read
end
if abs(i_unsel_y) > 0.05
  let fail = 1
  echo FAIL unselected Y1 current during X00 read
end
if abs(i_unsel_x0) > 0.05
  let fail = 1
  echo FAIL unselected X0 current during X01 read
end
if abs(i_g1) > 0.005
  let fail = 1
  echo FAIL group-1 HS current while address stays in group 0
end
meas tran dout_8 FIND v(dout) AT=10.30u
if dout_8 < 1.5
  let fail = 1
  echo FAIL DOUT low after read at 8u
end
meas tran dout_20 FIND v(dout) AT=22.30u
if dout_20 < 1.5
  let fail = 1
  echo FAIL DOUT low after read at 20u
end
meas tran dout_50 FIND v(dout) AT=52.30u
if dout_50 < 1.5
  let fail = 1
  echo FAIL DOUT low after read at 50u
end
meas tran dout_62 FIND v(dout) AT=64.30u
if dout_62 < 1.5
  let fail = 1
  echo FAIL DOUT low after read at 62u
end
meas tran dout_92 FIND v(dout) AT=94.30u
if dout_92 < 1.5
  let fail = 1
  echo FAIL DOUT low after read at 92u
end
meas tran dout_104 FIND v(dout) AT=106.35u
if dout_104 < 1.5
  let fail = 1
  echo FAIL DOUT low after read at 104u
end
meas tran dout_134 FIND v(dout) AT=136.35u
if dout_134 < 1.5
  let fail = 1
  echo FAIL DOUT low after read at 134u
end
meas tran dout_146 FIND v(dout) AT=148.35u
if dout_146 < 1.5
  let fail = 1
  echo FAIL DOUT low after read at 146u
end
meas tran dout_32 FIND v(dout) AT=34.30u
if dout_32 > 0.5
  let fail = 1
  echo FAIL DOUT high after read at 32u
end
meas tran dout_74 FIND v(dout) AT=76.30u
if dout_74 > 0.5
  let fail = 1
  echo FAIL DOUT high after read at 74u
end
meas tran dout_116 FIND v(dout) AT=118.35u
if dout_116 > 0.5
  let fail = 1
  echo FAIL DOUT high after read at 116u
end
meas tran dout_158 FIND v(dout) AT=160.35u
if dout_158 > 0.5
  let fail = 1
  echo FAIL DOUT high after read at 158u
end
meas tran idle_rev FIND v(g_x0w) AT=10.5u
if idle_rev > 0.2
  let fail = 1
  echo FAIL REV gate on during a FWD read
end
* Enables open. The 10 kohm pulls hold DEC_EN low and both banks inactive.
meas tran g_off_x0r FIND v(g_x0r) AT=174u
meas tran g_off_x1r FIND v(g_x1r) AT=174u
meas tran g_off_x0w FIND v(g_x0w) AT=174u
meas tran g_off_x1w FIND v(g_x1w) AT=174u
meas tran g_off_y0r FIND v(g_y0r) AT=174u
meas tran g_off_y1r FIND v(g_y1r) AT=174u
meas tran g_off_y0w FIND v(g_y0w) AT=174u
meas tran g_off_y1w FIND v(g_y1w) AT=174u
meas tran dout_open FIND v(dout) AT=174u
if g_off_x0r > 0.05
  let fail = 1
  echo FAIL X0 FWD gate on with enables open
end
if g_off_x1r > 0.05
  let fail = 1
  echo FAIL X1 FWD gate on with enables open
end
if g_off_x0w > 0.05
  let fail = 1
  echo FAIL X0 REV gate on with enables open
end
if g_off_x1w > 0.05
  let fail = 1
  echo FAIL X1 REV gate on with enables open
end
if g_off_y0r > 0.05
  let fail = 1
  echo FAIL Y0 FWD gate on with enables open
end
if g_off_y1r > 0.05
  let fail = 1
  echo FAIL Y1 FWD gate on with enables open
end
if g_off_y0w > 0.05
  let fail = 1
  echo FAIL Y0 REV gate on with enables open
end
if g_off_y1w > 0.05
  let fail = 1
  echo FAIL Y1 REV gate on with enables open
end
if dout_open > 0.5
  let fail = 1
  echo FAIL DOUT rose with enables open
end
if fail = 0
  echo RESULT PASS
else
  echo RESULT FAIL
end
.endc
.end

