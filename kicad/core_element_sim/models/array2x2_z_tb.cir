let fail = 0

if m_x00_x00_w1 < 0.9
  let fail = 1
  echo FAIL X00 write 1 did not set X00
end
if m_x01_x00_w1 > -0.9
  let fail = 1
  echo FAIL X00 write 1 left X01 high
end
if m_x10_x00_w1 > -0.9
  let fail = 1
  echo FAIL X00 write 1 left X10 high
end
if m_x11_x00_w1 > -0.9
  let fail = 1
  echo FAIL X00 write 1 left X11 high
end
let pk = smax_x00_w1
if abs(smin_x00_w1) > pk
  let pk = abs(smin_x00_w1)
end
if pk < 15m
  let fail = 1
  echo FAIL X00 write 1 sense below 15 mV
end
if pk > 80m
  let fail = 1
  echo FAIL X00 write 1 sense above 80 mV
end
if ix_x00_w1 < 0.34
  let fail = 1
  echo FAIL X00 write 1 X current low
end
if ix_x00_w1 > 0.46
  let fail = 1
  echo FAIL X00 write 1 X current high
